                <mxCell id="brick" value="&lt;b&gt;Brick Schema&lt;/b&gt;&lt;br&gt;&lt;i&gt;[オープン標準・実装規格]&lt;/i&gt;&lt;br&gt;Location / Equipment / Pointの&lt;br&gt;3クラスでビル設備をRDF/OWLで&lt;br&gt;厳密にグラフ表現。&lt;br&gt;FDD・エネルギー最適化に活用" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d6b656;fontSize=10;fontColor=#5a3000;" parent="1" vertex="1">
                    <mxGeometry x="510" y="570" width="210" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="haystack" value="&lt;b&gt;Project Haystack&lt;/b&gt;&lt;br&gt;&lt;i&gt;[オープン標準・実装規格]&lt;/i&gt;&lt;br&gt;equip / point / sensor / hvac等の&lt;br&gt;テキストタグで設備に意味付け。&lt;br&gt;グラフではなくタグ集合。&lt;br&gt;導入が容易・普及率高" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d6b656;fontSize=10;fontColor=#5a3000;" parent="1" vertex="1">
                    <mxGeometry x="750" y="570" width="210" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="ifc" value="&lt;b&gt;IFC&lt;/b&gt;&lt;br&gt;(Industry Foundation Classes)&lt;br&gt;&lt;i&gt;[ISO・BIM実装規格]&lt;/i&gt;&lt;br&gt;建築物の3D物理構造・&lt;br&gt;幾何学情報のデータフォーマット。&lt;br&gt;論理ではなく物理情報を担う" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d6b656;fontSize=10;fontColor=#5a3000;" parent="1" vertex="1">
                    <mxGeometry x="990" y="570" width="200" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="rec" value="&lt;b&gt;RealEstateCore (REC)&lt;/b&gt;&lt;br&gt;&lt;i&gt;[オープン標準・実装規格]&lt;/i&gt;&lt;br&gt;BOT＋Brick Schema＋ビジネスロジックを統合。&lt;br&gt;テナント管理・施設保守・財務など&lt;br&gt;不動産運用に特化した統合オントロジー。&lt;br&gt;Azure Digital Twins（DTDL）と連携" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d6b656;fontSize=10;fontColor=#5a3000;" parent="1" vertex="1">
